worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout combined;
    server_tokens off;

    client_max_body_size 27m;
    client_body_timeout 30s;
    send_timeout 60s;
    keepalive_timeout 15s;

    limit_req_zone $binary_remote_addr zone=network_req:10m rate=20r/s;
    limit_conn_zone $binary_remote_addr zone=network_conn:10m;

    upstream network_backend {
        server 127.0.0.1:${BACKEND_PORT};
        keepalive 16;
    }

    server {
        listen ${PORT};
        server_name _;

        location = /healthz {
            proxy_pass http://network_backend;
            proxy_connect_timeout 5s;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        location / {
            limit_req zone=network_req burst=60 nodelay;
            limit_conn network_conn 20;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            # Update 15: fail fast if the app is not listening yet
            # (5s instead of nginx's 60s default) so a request
            # during a restart gets a quick 502 and can be
            # retried, instead of hanging for a minute. start.sh
            # already waits for /healthz before starting nginx,
            # so in normal operation this should never trigger.
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
            proxy_pass http://network_backend;
        }
    }
}
